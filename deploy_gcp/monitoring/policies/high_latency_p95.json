{
  "displayName": "Backend - High request latency (p95)",
  "documentation": {
    "content": "The 95th-percentile API request latency exceeded 2s for 5 minutes. This metric (logging.googleapis.com/user/api_request_latency) EXCLUDES long-lived streaming endpoints (/socket.io, /messages/stream), so it reflects real API/DB latency. Investigate slow database queries (e.g., un-indexed user search), Redis contention, or downstream API slowness.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "API p95 latency > 2s (5m, excl. streaming)",
      "conditionThreshold": {
        "filter": "resource.type = \"cloud_run_revision\" AND resource.label.\"service_name\" = \"matrimonial-backend\" AND metric.type = \"logging.googleapis.com/user/api_request_latency\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_PERCENTILE_95",
            "crossSeriesReducer": "REDUCE_MAX"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 2,
        "duration": "300s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "alertStrategy": {
    "autoClose": "1800s"
  },
  "notificationChannels": ["__NOTIFICATION_CHANNEL__"],
  "enabled": true
}
